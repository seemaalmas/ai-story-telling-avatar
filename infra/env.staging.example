# ===========================================
# Katha AI - Staging Environment
# ===========================================
# Store these in GitHub Environment Secrets (environment: staging)
# or AWS Secrets Manager / GCP Secret Manager

NODE_ENV=staging
APP_NAME=katha-ai
APP_PORT=7000

# ─── Database (RDS) ─────────────────────────────────────
DATABASE_URL=postgresql://katha:CHANGE_ME@katha-staging.xxxxx.ap-south-1.rds.amazonaws.com:5432/katha_staging?schema=public&sslmode=require

# ─── Redis (ElastiCache) ────────────────────────────────
REDIS_HOST=katha-staging.xxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ─── Auth (generate with: openssl rand -base64 48) ──────
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_SECRET=CHANGE_ME_EXACTLY_32_CHARACTERS!

# ─── OTP ────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_TTL=60000
OTP_RATE_LIMIT_MAX=3
MAX_DEVICE_SESSIONS=5

# ─── OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=https://staging-api.katha.ai/api/v1/auth/google/callback
APPLE_CLIENT_ID=com.katha.ai
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----

# ─── AI ─────────────────────────────────────────────────
AI_PROVIDER=mock
# Switch to real when ready:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ─── Voice ──────────────────────────────────────────────
TTS_PROVIDER=mock
STT_PROVIDER=mock
DEFAULT_VOICE_ID=mock-dadi
MAX_SYNTHESIS_CHARS=5000
ENABLE_SELF_VOICE_ENROLLMENT=false
ABUSE_AUTO_SUSPEND_THRESHOLD=3

# ─── Story Engine ──────────────────────────────────────
STORY_MAX_TURNS=20
STORY_MAX_CHOICES=3
STORY_SESSION_TTL=7200
STORY_MAX_CONTEXT_CHARS=8000
STORY_WIND_DOWN_TURN=15

# ─── Subscription ──────────────────────────────────────
TRIAL_DAYS=7
# APPLE_SHARED_SECRET=   (set when App Store IAP is configured)
# GOOGLE_SERVICE_ACCOUNT_KEY=  (set when Play Store IAP is configured)

# ─── Infrastructure ────────────────────────────────────
BULL_QUEUE_PREFIX=katha-staging
SENTRY_DSN=https://xxx@sentry.io/staging
CORS_ORIGINS=https://staging-admin.katha.ai
ADMIN_PORT=7001
