generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum StoryStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_EMAIL
  DATA_PROCESSING
  ANALYTICS
  PUSH_NOTIFICATIONS
  VOICE_ENROLLMENT
  VOICE_BIOMETRIC_STORAGE
  VOICE_SYNTHETIC_USE
}

enum VoiceEnrollmentStatus {
  PENDING_CONSENT
  CONSENT_GRANTED
  SAMPLES_UPLOADING
  PROCESSING
  READY
  FAILED
  REVOKED
}

enum AbuseReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED_ACTION_TAKEN
  RESOLVED_NO_ACTION
  DISMISSED
}

enum PlanId {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
  FAMILY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
  PAUSED
}

enum StorePlatform {
  APP_STORE
  PLAY_STORE
  WEB
  MANUAL
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String?
  name              String
  avatarUrl         String?
  role              UserRole     @default(USER)
  authProvider      AuthProvider @default(EMAIL)
  authProviderId    String?
  preferredLanguage String       @default("en")
  isActive          Boolean      @default(true)
  emailVerified     Boolean      @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  stories           Story[]
  storySessions     StorySession[]
  avatars           Avatar[]
  refreshTokens     RefreshToken[]
  deviceSessions    DeviceSession[]
  preferences       UserPreference[]
  consents          Consent[]
  otpCodes          OtpCode[]
  voiceEnrollments  VoiceEnrollment[]
  abuseReports      AbuseReport[]     @relation("reporter")
  subscriptions     Subscription[]
  entitlementAudits EntitlementAudit[]

  @@index([email])
  @@index([authProvider, authProviderId])
  @@map("users")
}

model OtpCode {
  id          String   @id @default(cuid())
  code        String
  email       String
  purpose     String   @default("LOGIN") // LOGIN, VERIFY_EMAIL, RESET_PASSWORD
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([email, purpose])
  @@index([code, email])
  @@map("otp_codes")
}

model RefreshToken {
  id              String         @id @default(cuid())
  token           String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSessionId String?
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([token])
  @@index([deviceSessionId])
  @@map("refresh_tokens")
}

model DeviceSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String
  deviceName      String?
  deviceOS        String?
  deviceOSVersion String?
  appVersion      String?
  pushToken       String?
  ipAddress       String?
  isActive        Boolean  @default(true)
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("device_sessions")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String   @db.Text
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  version   String      @default("1.0")
  ipAddress String?
  userAgent String?
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, type, version])
  @@index([userId])
  @@index([type])
  @@map("consents")
}

model Avatar {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  voiceId     String?
  style       Json?
  isPublic    Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stories Story[]

  @@index([userId])
  @@map("avatars")
}

model Story {
  id        String      @id @default(cuid())
  title     String
  prompt    String
  content   String?     @db.Text
  language  String      @default("en")
  status    StoryStatus @default(DRAFT)
  metadata  Json?
  duration  Int?
  audioUrl  String?
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId  String?
  avatar    Avatar?     @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  storySessions StorySession[]

  @@index([userId])
  @@index([status])
  @@index([language])
  @@map("stories")
}

// ─── Story Engine ──────────────────────────────────────────

enum StoryMode {
  BEDTIME
  WARRIOR_SUCCESS
  MYTHOLOGY
  MOTIVATION
}

enum StoryTone {
  CALM
  FUNNY
  ENERGETIC
}

model StorySession {
  id          String     @id @default(cuid())
  sessionId   String     @unique
  storyId     String
  story       Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        StoryMode
  tone        StoryTone
  language    String     @default("en")
  totalTurns  Int        @default(0)
  path        Json       @default("[]")
  summary     String?    @db.Text
  nodes       Json?
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([storyId])
  @@index([sessionId])
  @@map("story_sessions")
}

// ─── Voice Pipeline ────────────────────────────────────────

model VoiceEnrollment {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceName        String
  languageCode     String
  status           VoiceEnrollmentStatus @default(PENDING_CONSENT)
  providerVoiceId  String?               // Provider-side voice ID once processing is complete
  sampleCount      Int                   @default(0)
  totalDurationMs  Int                   @default(0)
  provider         String?               // Provider used for voice creation
  failureReason    String?               // Reason if status is FAILED
  consentGrantedAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@map("voice_enrollments")
}

model AbuseReport {
  id              String            @id @default(cuid())
  reporterUserId  String
  reporter        User              @relation("reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType      String
  targetId        String
  category        String
  description     String            @db.Text
  status          AbuseReportStatus @default(OPEN)
  resolutionNotes String?           @db.Text // Admin notes on resolution
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([reporterUserId])
  @@index([targetType, targetId])
  @@index([status])
  @@map("abuse_reports")
}

// ─── Subscriptions & Entitlements ──────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             PlanId             @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  platform           StorePlatform      @default(MANUAL)
  storeProductId     String?            // Product ID from the app store
  storeTransactionId String?            // Original transaction ID from the store
  latestReceipt      String?            @db.Text // Latest receipt for re-validation
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  autoRenew          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, planId, platform])
  @@index([userId])
  @@index([status])
  @@index([storeTransactionId])
  @@map("subscriptions")
}

model EntitlementAudit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  planId        String?
  platform      String?
  transactionId String?
  entitlements  Json?    // Snapshot of entitlements at the time of the event
  details       Json?    // Extra details (receipt excerpt, error, etc.)
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("entitlement_audits")
}

// ─── Admin: Feature Flags & Audit ──────────────────────────

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique
  enabled      Boolean  @default(false)
  description  String?
  rules        Json?    // JSON rules: percentage rollout, user IDs, etc.
  isKillSwitch Boolean  @default(false)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([key])
  @@map("feature_flags")
}

model AdminAudit {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  resource    String
  resourceId  String?
  before      Json?
  after       Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("admin_audits")
}
