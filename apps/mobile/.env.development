# Mobile App - Development Defaults (committed to git)
# Expo requires the EXPO_PUBLIC_ prefix to expose vars to the app

# iOS Simulator: localhost works
# Android Emulator: use 10.0.2.2 (Android's alias for host machine)
# Physical device: use your computer's LAN IP (e.g. 192.168.1.x)
EXPO_PUBLIC_API_URL=http://localhost:7000
