    "expo": "~51.0.0",
    "expo-auth-session": "~5.5.0",
    "expo-crypto": "~13.0.0",
    "expo-font": "~12.0.0",
    "expo-image": "~1.12.0",
    "expo-localization": "~15.0.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "i18next": "^23.0.0",
    "react": "18.2.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.74.0",
    "react-native-reanimated": "~3.10.0",
