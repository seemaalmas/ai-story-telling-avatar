    "axios": "^1.6.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.0",
    "expo-crypto": "~15.0.0",
    "expo-font": "~14.0.0",
    "expo-image": "~3.0.0",
    "expo-localization": "~17.0.0",
    "expo-router": "~5.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~0.30.0",
    "expo-status-bar": "~2.2.0",
    "i18next": "^23.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.79.2",
    "react-native-reanimated": "~3.17.0",
