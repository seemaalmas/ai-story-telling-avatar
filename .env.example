# ===========================================
# Katha AI - Environment Configuration
# ===========================================
# Copy to .env.local for local development

# App
NODE_ENV=development
APP_NAME=katha-ai
APP_PORT=7000

# Database (Postgres)
DATABASE_URL=postgresql://katha:katha_secret@localhost:5432/katha_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_TTL=60000
OTP_RATE_LIMIT_MAX=3

# Encryption (for sensitive user preferences)
ENCRYPTION_SECRET=change-me-32-char-secret-key!!!

# Device Sessions
MAX_DEVICE_SESSIONS=5

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7000/api/v1/auth/google/callback

# OAuth - Apple (for iOS)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AI Providers
# Set AI_PROVIDER to 'grok' for real AI story generation, 'mock' for development.
AI_PROVIDER=mock
# GROK_API_KEY=xai-your-api-key-here
# GROK_MODEL=grok-3-mini-fast
# GROK_BASE_URL=https://api.x.ai/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# Storage
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Story Engine
STORY_MAX_TURNS=20
STORY_MAX_CHOICES=3
STORY_SESSION_TTL=7200
STORY_MAX_CONTEXT_CHARS=8000
STORY_WIND_DOWN_TURN=15

# Voice Pipeline
TTS_PROVIDER=mock
STT_PROVIDER=mock
DEFAULT_VOICE_ID=mock-dadi
MAX_SYNTHESIS_CHARS=5000
ENABLE_SELF_VOICE_ENROLLMENT=false
ABUSE_AUTO_SUSPEND_THRESHOLD=3
# ELEVENLABS_API_KEY=
# GOOGLE_TTS_API_KEY=
# DEEPGRAM_API_KEY=

# Subscription & Entitlements
# APPLE_SHARED_SECRET=
# GOOGLE_SERVICE_ACCOUNT_KEY=
# SUBSCRIPTION_WEBHOOK_SECRET=
TRIAL_DAYS=0

# BullMQ
BULL_QUEUE_PREFIX=katha

# Observability
SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=katha-api

# CORS (comma-separated origins). Leave unset in dev — all localhost ports are allowed.
# CORS_ORIGINS=https://admin.katha.ai

# Admin
ADMIN_PORT=7001
