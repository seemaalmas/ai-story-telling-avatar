# ===========================================
# Katha AI - Environment Configuration
# ===========================================
# Copy to .env.local for local development

# App
NODE_ENV=development
APP_NAME=katha-ai
APP_PORT=3000

# Database (Postgres)
DATABASE_URL=postgresql://katha:katha_secret@localhost:5432/katha_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_TTL=60000
OTP_RATE_LIMIT_MAX=3

# Encryption (for sensitive user preferences)
ENCRYPTION_SECRET=change-me-32-char-secret-key!!!

# Device Sessions
MAX_DEVICE_SESSIONS=5

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth - Apple (for iOS)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AI Providers (not implemented yet - interfaces only)
AI_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# Storage
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Story Engine
STORY_MAX_TURNS=20
STORY_MAX_CHOICES=3
STORY_SESSION_TTL=7200
STORY_MAX_CONTEXT_CHARS=8000
STORY_WIND_DOWN_TURN=15

# BullMQ
BULL_QUEUE_PREFIX=katha

# Sentry (optional)
SENTRY_DSN=

# Admin
ADMIN_PORT=3001
