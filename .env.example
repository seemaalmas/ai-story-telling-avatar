# ===========================================
# Katha AI - Environment Configuration
# ===========================================
# Copy to .env.local for local development

# App
NODE_ENV=development
APP_NAME=katha-ai
APP_PORT=3000

# Database (Postgres)
DATABASE_URL=postgresql://katha:katha_secret@localhost:5432/katha_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_TTL=60000
OTP_RATE_LIMIT_MAX=3

# Encryption (for sensitive user preferences)
ENCRYPTION_SECRET=change-me-32-char-secret-key!!!

# Device Sessions
MAX_DEVICE_SESSIONS=5

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth - Apple (for iOS)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AI Providers (not implemented yet - interfaces only)
AI_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# Storage
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Story Engine
STORY_MAX_TURNS=20
STORY_MAX_CHOICES=3
STORY_SESSION_TTL=7200
STORY_MAX_CONTEXT_CHARS=8000
STORY_WIND_DOWN_TURN=15

# Voice Pipeline
TTS_PROVIDER=mock
STT_PROVIDER=mock
DEFAULT_VOICE_ID=mock-dadi
MAX_SYNTHESIS_CHARS=5000
ENABLE_SELF_VOICE_ENROLLMENT=false
ABUSE_AUTO_SUSPEND_THRESHOLD=3
# ELEVENLABS_API_KEY=
# GOOGLE_TTS_API_KEY=
# DEEPGRAM_API_KEY=

# Subscription & Entitlements
# APPLE_SHARED_SECRET=
# GOOGLE_SERVICE_ACCOUNT_KEY=
# SUBSCRIPTION_WEBHOOK_SECRET=
TRIAL_DAYS=0

# BullMQ
BULL_QUEUE_PREFIX=katha

# Observability
SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=katha-api

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001

# Admin
ADMIN_PORT=3001
