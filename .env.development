# ===========================================
# Katha AI - Development Defaults
# ===========================================
# This file IS committed to git. It contains ONLY safe defaults.
# For real secrets, create .env.local (which is gitignored).
# .env.local values override these.

# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
APP_NAME=katha-ai
APP_PORT=3000

# ─── Database (matches docker-compose.yml) ──────────────
DATABASE_URL=postgresql://katha:katha_secret@localhost:5432/katha_dev?schema=public

# ─── Redis (matches docker-compose.yml) ─────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth (DEV ONLY — not secure for production) ────────
JWT_SECRET=dev-only-jwt-secret-not-for-production-use
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP ────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_TTL=60000
OTP_RATE_LIMIT_MAX=3

# ─── Encryption (DEV ONLY — not secure for production) ──
ENCRYPTION_SECRET=dev-only-32-char-secret-key!!!!

# ─── Device Sessions ───────────────────────────────────
MAX_DEVICE_SESSIONS=5

# ─── OAuth (blank = social login disabled, OTP still works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── AI Providers (mock = no API keys needed) ──────────
AI_PROVIDER=mock

# ─── Storage ───────────────────────────────────────────
STORAGE_PROVIDER=local

# ─── Story Engine ──────────────────────────────────────
STORY_MAX_TURNS=20
STORY_MAX_CHOICES=3
STORY_SESSION_TTL=7200
STORY_MAX_CONTEXT_CHARS=8000
STORY_WIND_DOWN_TURN=15

# ─── Voice Pipeline (mock = no API keys needed) ────────
TTS_PROVIDER=mock
STT_PROVIDER=mock
DEFAULT_VOICE_ID=mock-dadi
MAX_SYNTHESIS_CHARS=5000
ENABLE_SELF_VOICE_ENROLLMENT=false
ABUSE_AUTO_SUSPEND_THRESHOLD=3

# ─── Subscription (mock validator accepts "mock_*" receipts)
TRIAL_DAYS=0

# ─── BullMQ ────────────────────────────────────────────
BULL_QUEUE_PREFIX=katha

# ─── Observability (blank = disabled) ──────────────────
SENTRY_DSN=

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# ─── Admin ──────────────────────────────────────────────
ADMIN_PORT=3001
